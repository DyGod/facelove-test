# Copy to .env and fill in. Never commit .env.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Default: agents use the Shopify CLI session (`shopify store execute`); no secrets needed.
# Fallback only — Dev Dashboard app (client credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Or, for an older admin-created custom app:
# SHOPIFY_ADMIN_TOKEN=shpat_...
