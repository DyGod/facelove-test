      "default": "Secure, encrypted checkout"
    },
    {
      "type": "header",
      "content": "t:landing.content.payment_icons"
    },
    {
      "type": "select",
      "id": "payment_source",
      "label": "t:landing.settings.payment_source",
      "options": [
        { "value": "store", "label": "t:landing.options.payment_store" },
        { "value": "list", "label": "t:landing.options.payment_list" },
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "store"
    },
    {
      "type": "text",
      "id": "payment_types",
      "label": "t:landing.settings.payment_types",
