        { "value": "shield", "label": "t:landing.options.shield" },
        { "value": "truck", "label": "t:landing.options.truck" },
        { "value": "lock", "label": "t:landing.options.lock" },
        { "value": "check", "label": "t:landing.options.glyph_check" }
      ],
      "default": "shield_check"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "t:landing.settings.badge_text_1",
      "default": "30-day money-back guarantee"
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "t:landing.settings.badge_icon_2",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "shield_check", "label": "t:landing.options.shield_check" },
        { "value": "shield", "label": "t:landing.options.shield" },
        { "value": "truck", "label": "t:landing.options.truck" },
        { "value": "lock", "label": "t:landing.options.lock" },
        { "value": "check", "label": "t:landing.options.glyph_check" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "t:landing.settings.badge_text_2",
