{%- doc -%}
  Renders a two-column grid of short benefit pills from a list of lines, one benefit per line.
  Each line can show its own icon image (icon_1 to icon_4, matched by line order); lines
  without an image fall back to a check mark in the icon color.
  The wrapper carries the `landing-buy` anchor so landing page buttons can scroll to the buy box.

  @example
  {% content_for 'block', type: 'landing-benefits', id: 'benefits' %}
{%- enddoc -%}

{%- assign benefits = block.settings.benefits | newline_to_br | split: '<br />' -%}

<div
  id="landing-buy"
  class="landing-benefits spacing-style"
  style="
    {% render 'spacing-style', settings: block.settings %}
    --landing-benefits-icon: {{ block.settings.icon_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.benefits != blank -%}
    <ul class="landing-benefits__list" role="list">
      {%- for benefit in benefits -%}
        {%- assign benefit_text = benefit | strip -%}
        {%- if benefit_text != blank -%}
          {%- liquid
            assign icon_key = 'icon_' | append: forloop.index
            assign icon_image = block.settings[icon_key]
          -%}
          <li class="landing-benefits__item">
            {%- if icon_image != blank -%}
              {{
                icon_image
                | image_url: width: 72
                | image_tag:
                  class: 'landing-benefits__icon landing-benefits__icon--image',
                  width: 18,
                  height: 18,
                  widths: '36, 54, 72',
                  sizes: '18px',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              <svg class="landing-benefits__icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16">
                <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
            <span>{{ benefit_text | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .landing-benefits {
    width: 100%;
    min-width: 0;
    scroll-margin-block-start: 96px;
  }

  .landing-benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .landing-benefits__item {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    min-width: 0;
    min-height: 34px;
    padding: var(--padding-xs) 10px;
    border-radius: var(--style-border-radius-sm);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.25;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
  }

  .landing-benefits__item > span {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .landing-benefits__icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--landing-benefits-icon);
  }

  .landing-benefits__icon--image {
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .landing-benefits__item {
      font-size: 0.6875rem;
    }
  }

  @media screen and (min-width: 990px) {
    .landing-benefits__item {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.names.benefit_pills",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "benefits",
      "label": "t:landing.settings.benefits",
      "info": "t:landing.info.benefits",
      "default": "Benefit one\nBenefit two\nBenefit three\nBenefit four"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:landing.settings.icon_color",
      "default": "#9B7FC0"
    },
    {
      "type": "header",
      "content": "t:landing.content.benefit_icons",
      "info": "t:landing.info.benefit_icons"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "t:landing.settings.icon_1"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "t:landing.settings.icon_2"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "t:landing.settings.icon_3"
    },
    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "t:landing.settings.icon_4"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:landing.names.benefit_pills",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
