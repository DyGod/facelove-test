

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        },
        {
          "value": "cards",
          "label": "t:options.cards"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' or block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style != 'dropdowns' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style != 'dropdowns' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style != 'dropdowns' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:landing.content.bundle_cards",
      "info": "t:landing.info.bundle_cards"
    },
    {
      "type": "textarea",
      "id": "card_subtitles",
      "label": "t:landing.settings.card_subtitles",
      "info": "t:landing.info.card_subtitles",
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "select",
      "id": "card_badge",
      "label": "t:landing.settings.card_badge",
      "options": [
        { "value": "all", "label": "t:landing.options.badge_all" },
        { "value": "gift_card", "label": "t:landing.options.badge_gift_card" },
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "all",
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "color",
      "id": "card_compare_color",
      "label": "t:landing.settings.card_compare_color",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "text",
      "id": "card_gift_value",
      "label": "t:landing.settings.card_gift_value",
      "info": "t:landing.info.card_gift_value",
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "product_list",
      "id": "card_gifts",
      "label": "t:landing.settings.gifts",
      "limit": 3
    },
    {
      "type": "checkbox",
      "id": "card_gift_shipping",
      "label": "t:landing.settings.show_free_shipping",
      "default": false,
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "image_picker",
      "id": "card_gift_shipping_image",
      "label": "t:landing.settings.shipping_image",
      "visible_if": "{{ block.settings.variant_style == 'cards' and block.settings.card_gift_shipping }}"
    },
    {
      "type": "checkbox",
      "id": "card_gift_auto_add",
      "label": "t:landing.settings.auto_add_gifts",
      "info": "t:landing.info.auto_add_gifts",
      "default": true,
      "visible_if": "{{ block.settings.variant_style == 'cards' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
