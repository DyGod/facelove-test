{%- doc -%}
  Renders a decorative inline SVG glyph for landing blocks. Glyphs draw with `currentColor`,
  so set the color on the SVG or a parent. Unknown names render nothing.

  @param {string} icon - Glyph name: check, sparkles, face_glow, arch, no_blemish, box, gift, shield, lock, verified
  @param {string} [class] - Class for the SVG element

  @example
  {% render 'landing-icon', icon: 'sparkles', class: 'landing-benefits__icon' %}
{%- enddoc -%}

{%- case icon -%}
  {%- when 'check' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <path d="M4.5 12.5l4.5 4.5L19.5 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'sparkles' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor">
      <path d="M10 4.5c.5 3.6 1.9 5 5.5 5.5-3.6.5-5 1.9-5.5 5.5-.5-3.6-1.9-5-5.5-5.5 3.6-.5 5-1.9 5.5-5.5z"/>
      <path d="M18 1.5c.25 1.6.9 2.25 2.5 2.5-1.6.25-2.25.9-2.5 2.5-.25-1.6-.9-2.25-2.5-2.5 1.6-.25 2.25-.9 2.5-2.5z"/>
      <path d="M17.5 14.5c.35 2.2 1.3 3.15 3.5 3.5-2.2.35-3.15 1.3-3.5 3.5-.35-2.2-1.3-3.15-3.5-3.5 2.2-.35 3.15-1.3 3.5-3.5z"/>
      <path d="M3.5 15.5c.2 1.4.8 2 2.2 2.2-1.4.2-2 .8-2.2 2.2-.2-1.4-.8-2-2.2-2.2 1.4-.2 2-.8 2.2-2.2z"/>
    </svg>
  {%- when 'face_glow' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <circle cx="12" cy="3.6" r="2.4" fill="currentColor"/>
      <path d="M3.2 12.2C3.2 7.6 6.6 5 10.4 5c3.3 0 5.8 1.7 6.7 4.6-2.7-.2-5.6-1.3-7.4-3-1.1 2.3-3.4 4.4-6.5 5.6z" fill="currentColor"/>
      <path d="M4 12.4c.3 4.4 3.1 7.6 6.6 7.6 1 0 1.9-.2 2.7-.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M6.4 13.6c.6.6 1.4.6 2 0M10.6 13.6c.6.6 1.4.6 2 0" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M19.4 9.4c.3 1.9 1.1 2.7 3 3-1.9.3-2.7 1.1-3 3-.3-1.9-1.1-2.7-3-3 1.9-.3 2.7-1.1 3-3z" fill="currentColor"/>
      <path d="M16.6 16.4c.25 1.5.85 2.1 2.4 2.4-1.55.25-2.15.85-2.4 2.4-.25-1.55-.85-2.15-2.4-2.4 1.55-.3 2.15-.9 2.4-2.4z" fill="currentColor"/>
    </svg>
  {%- when 'arch' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.6 3.6L12 1.6l2.4 2" stroke-width="1.6"/>
      <circle cx="12" cy="5.6" r="1.4" stroke-width="1.4"/>
      <path d="M2.5 22c0-7.6 4.2-14.6 9.5-14.6S21.5 14.4 21.5 22" stroke-width="2"/>
      <path d="M6.6 22c0-5.6 2.4-10 5.4-10s5.4 4.4 5.4 10" stroke-width="1.4" opacity=".7"/>
    </svg>
  {%- when 'no_blemish' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"/>
      <path d="M5 19L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <circle cx="9.2" cy="9.4" r="2.1" fill="currentColor" opacity=".55"/>
      <circle cx="14.4" cy="14.6" r="1.6" fill="currentColor" opacity=".55"/>
    </svg>
  {%- when 'box' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 48 48">
      <path d="M24 5l18 8v22l-18 8-18-8V13z" fill="#C8955A"/>
      <path d="M6 13l18 8v22l-18-8z" fill="#B47F45"/>
      <path d="M24 21l18-8v22l-18 8z" fill="#D9A86C"/>
      <path d="M6 13l18-8 18 8-18 8z" fill="#E4BC86"/>
      <path d="M14.5 9.2l18 8v6.6l-4.5-2v-6.6l-18-8z" fill="#F3E3C6"/>
      <path d="M30 31.4l7.6-3.4v3.4L30 34.8z" fill="#FFFFFF" opacity=".75"/>
    </svg>
  {%- when 'gift' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 48 48">
      <rect x="7" y="20" width="34" height="23" rx="2" fill="#C9B6E4"/>
      <rect x="5" y="13" width="38" height="9" rx="2" fill="#B69FD1"/>
      <rect x="21" y="13" width="6" height="30" fill="#8E6DBB"/>
      <path d="M24 13c-3-6-10-8-11.5-4.4C11 12 18 13 24 13zm0 0c3-6 10-8 11.5-4.4C37 12 30 13 24 13z" fill="none" stroke="#8E6DBB" stroke-width="2.4" stroke-linejoin="round"/>
    </svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
    </svg>
  {%- when 'lock' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="11" x="3" y="11" rx="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
  {%- when 'verified' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <path d="M12 1.5l2.6 1.9 3.2-.1 1 3 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3 3.2.1z" fill="currentColor"/>
      <path d="M8 12.2l2.7 2.7L16.2 9.4" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
