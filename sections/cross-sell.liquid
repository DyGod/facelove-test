{% comment %}
  Section contract.
  Shows Cross-sells as large cards under an eyebrow, heading and intro, so shoppers reading the
  page can add products that pair with the hero product without leaving it. A swipe row with the
  next card peeking in on mobile and tablet, three columns from desktop up.
  @example
  <!-- Add "Cross-sell" to a product landing template and pick one product per Cross-sell product block -->
{% endcomment %}

{%- capture cards -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- if cards contains 'cross-sell-item' or request.design_mode -%}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

  <div class="section-background color-custom-{{ section.id }}"></div>
  <div class="section section--page-width color-custom-{{ section.id }}">
    <div
      class="cross-sell-cards spacing-style"
      style="
        {% render 'spacing-style', settings: section.settings %}
        --cross-sell-accent: {{ section.settings.accent_color }};
        --cross-sell-highlight: {{ section.settings.highlight_color }};
      "
    >
      {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="cross-sell-cards__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cross-sell-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="cross-sell-cards__heading" id="CrossSellHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="cross-sell-cards__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="cross-sell-cards__list"
        {% if section.settings.heading != blank %}
          role="region"
          aria-labelledby="CrossSellHeading-{{ section.id }}"
        {% endif %}
      >
        {{ cards }}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .cross-sell-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-xl);
    width: min(100%, 1100px);
    min-width: 0;
    margin-inline: auto;
  }

  .cross-sell-cards__intro {
    display: grid;
    gap: var(--gap-xs);
    text-align: center;
  }

  .cross-sell-cards__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cross-sell-highlight);
  }

  .cross-sell-cards__heading {
    margin: 0;
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .cross-sell-cards__text {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cross-sell-cards__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: var(--gap-md);
    margin-inline: calc(-1 * var(--page-margin));
    padding-inline: var(--page-margin);
    scroll-padding-inline: var(--page-margin);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .cross-sell-cards__list::-webkit-scrollbar {
    display: none;
  }

  .cross-sell-cards__list:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .cross-sell-cards .cross-sell-item {
    grid-template-rows: auto 1fr auto;
    gap: var(--gap-sm);
    scroll-snap-align: start;
  }

  .cross-sell-cards .cross-sell-item__media {
    aspect-ratio: 1;
    border-radius: 20px;
  }

  .cross-sell-cards .cross-sell-item__body {
    gap: 6px;
    text-align: center;
  }

  .cross-sell-cards .cross-sell-item__name {
    font-size: 1.375rem;
  }

  .cross-sell-cards .cross-sell-item__benefit {
    font-size: 0.875rem;
  }

  .cross-sell-cards .cross-sell-item__price {
    justify-content: center;
  }

  .cross-sell-cards .cross-sell-item__add {
    width: 100%;
  }

  .cross-sell-cards .cross-sell-item[data-state='open'] .cross-sell-item__action {
    display: none;
  }

  .cross-sell-cards .cross-sell-item__legend {
    text-align: center;
  }

  .cross-sell-cards .cross-sell-item__option {
    flex: 1 1 100%;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .cross-sell-cards__list {
      grid-auto-columns: 42%;
    }
  }

  @media screen and (min-width: 990px) {
    .cross-sell-cards {
      gap: var(--gap-2xl);
    }

    .cross-sell-cards__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap-xl);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.names.cross_sell",
  "class": "cross-sell-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_cross-sell-product"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:landing.info.cross_sell"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:landing.settings.eyebrow",
      "default": "Pairs with your stick"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Complete your routine"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:landing.settings.subheading",
      "default": "The finishing touches our customers add most."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:landing.settings.button_color",
      "default": "#3B2A4A"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "t:landing.settings.added_color",
      "default": "#B8976A"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "alpha": true,
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:landing.names.cross_sell",
      "blocks": {
        "product_1": { "type": "_cross-sell-product" },
        "product_2": { "type": "_cross-sell-product" },
        "product_3": { "type": "_cross-sell-product" }
      },
      "block_order": ["product_1", "product_2", "product_3"]
    }
  ]
}
{% endschema %}
