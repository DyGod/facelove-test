{% comment %}
  Section contract.
  Names the key ingredients of a product in short cards under an eyebrow, heading and intro,
  so shoppers see what the formula does for their skin. Two columns on mobile, one row from tablet up.
  @example
  <!-- Add "Ingredient spotlight" to a product landing template and add one Ingredient block per ingredient -->
{% endcomment %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div class="section section--page-width color-custom-{{ section.id }}">
  <div
    class="landing-ingredients spacing-style"
    style="
      {% render 'spacing-style', settings: section.settings %}
      --landing-ingredients-accent: {{ section.settings.accent_color }};
      --landing-ingredients-card: {{ section.settings.card_background }};
    "
  >
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.text != blank
    -%}
      <div class="landing-ingredients__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="landing-ingredients__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-ingredients__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="landing-ingredients__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="landing-ingredients__list" role="list">
        {%- for block in section.blocks -%}
          <li class="landing-ingredients__item" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <span class="landing-ingredients__label" aria-hidden="true">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            {%- if block.settings.name != blank -%}
              <h3 class="landing-ingredients__name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="landing-ingredients__description rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="landing-ingredients__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .landing-ingredients {
    display: grid;
    gap: var(--gap-xl);
    width: min(100%, 1100px);
    min-width: 0;
    margin-inline: auto;
  }

  .landing-ingredients__intro {
    display: grid;
    justify-items: center;
    gap: var(--gap-xs);
    text-align: center;
  }

  .landing-ingredients__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--landing-ingredients-accent);
  }

  .landing-ingredients__heading {
    margin: 0;
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .landing-ingredients__text {
    max-width: 52ch;
    font-size: 0.9375rem;
    color: var(--color-foreground-muted);
  }

  .landing-ingredients__text > * {
    margin: 0;
  }

  .landing-ingredients__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .landing-ingredients__item {
    display: grid;
    align-content: start;
    gap: var(--gap-2xs);
    min-width: 0;
    padding: var(--padding-lg) var(--padding-md);
    border-radius: var(--style-border-radius-md);
    background-color: var(--landing-ingredients-card);
  }

  .landing-ingredients__label {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1;
    color: var(--landing-ingredients-accent);
  }

  .landing-ingredients__name {
    margin: var(--margin-xs) 0 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .landing-ingredients__description {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-foreground-muted);
    overflow-wrap: break-word;
  }

  .landing-ingredients__description > * {
    margin: 0;
  }

  .landing-ingredients__footnote {
    margin: 0;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--color-foreground-muted);
  }

  @media screen and (min-width: 750px) {
    .landing-ingredients__list {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: var(--gap-md);
    }

    .landing-ingredients__item {
      padding: var(--padding-xl) var(--padding-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.names.ingredients",
  "class": "landing-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:landing.settings.eyebrow",
      "default": "The formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Skincare first, then coverage"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:landing.settings.footnote"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:landing.settings.accent_color",
      "default": "#B8976A"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:landing.settings.card_background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "alpha": true,
      "default": "#F7F3EE"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:landing.names.ingredient",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:landing.settings.number_label",
          "default": "i."
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:landing.settings.ingredient_name",
          "default": "Ingredient"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text",
          "default": "<p>Say what this ingredient does for the skin.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:landing.names.ingredients",
      "blocks": {
        "ingredient_1": { "type": "ingredient", "settings": { "label": "i." } },
        "ingredient_2": { "type": "ingredient", "settings": { "label": "ii." } },
        "ingredient_3": { "type": "ingredient", "settings": { "label": "iii." } },
        "ingredient_4": { "type": "ingredient", "settings": { "label": "iv." } }
      },
      "block_order": ["ingredient_1", "ingredient_2", "ingredient_3", "ingredient_4"]
    }
  ]
}
{% endschema %}
